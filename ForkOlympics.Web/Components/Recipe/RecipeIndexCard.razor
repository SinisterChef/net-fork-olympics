<a href="/recipes/@Slug" class="group flex flex-col rounded-2xl overflow-hidden bg-white shadow-sm hover:shadow-md transition-shadow">
    <div class="aspect-[16/9] overflow-hidden">
        <img src="@HeroUrl" alt="@AltText"
             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out" />
    </div>
    <div class="flex flex-col flex-1 p-5 gap-3">
        <div class="flex flex-wrap gap-1.5">
            @foreach (var tag in Tags)
            {
                <TagPill Tag="tag" />
            }
        </div>
        <h2 class="font-bold text-xl text-zinc-900 leading-snug group-hover:text-amber-700 transition-colors line-clamp-2">
            @Title
        </h2>
        <div class="mt-auto pt-3 border-t border-zinc-100">
            <AuthorByline Author="Author" PublishedAt="PublishedAt" />
        </div>
    </div>
</a>

@code {
    [Parameter, EditorRequired] public string Slug { get; set; } = "";
    [Parameter, EditorRequired] public string HeroUrl { get; set; } = "";
    [Parameter] public string AltText { get; set; } = "";
    [Parameter, EditorRequired] public IEnumerable<Tag> Tags { get; set; } = [];
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public Author Author { get; set; } = null!;
    [Parameter] public DateTime? PublishedAt { get; set; }
}
