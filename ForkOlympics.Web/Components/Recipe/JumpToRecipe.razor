@inject NavigationManager Nav

<div class="flex items-center gap-4 my-8">
    <div class="flex-1 h-px bg-zinc-200"></div>
    <a href="#recipe"
       @onclick="ScrollToRecipe"
       @onclick:preventDefault
       class="inline-flex items-center gap-2 bg-[#1e3a5f] hover:bg-[#16304f] text-white text-sm font-bold uppercase tracking-widest px-6 py-3 transition-colors cursor-pointer">
        Jump to Recipe
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
    </a>
    <div class="flex-1 h-px bg-zinc-200"></div>
</div>

@code {
    private void ScrollToRecipe() => Nav.NavigateTo(Nav.Uri.Split('#')[0] + "#recipe");
}
