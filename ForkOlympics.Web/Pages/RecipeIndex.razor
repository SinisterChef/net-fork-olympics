@page "/recipes"
@inject RecipeService RecipeService

<PageTitle>Recipes – Fork Olympics</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <h1 class="text-3xl font-bold text-zinc-900 mb-6">Recipes</h1>

    <div class="mb-8">
        <RecipeSearchBar OnSearchChanged="HandleSearchChanged" />
    </div>

    @if (recipes is null)
    {
        <p class="text-zinc-400">Loading...</p>
    }
    else if (!filteredRecipes.Any())
    {
        <p class="text-zinc-400">No recipes found for "@searchTerm".</p>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            @foreach (var item in filteredRecipes)
            {
                var hero = item.MediaAssets.FirstOrDefault(m => m.Role == MediaRole.Hero);
                var tags = item.ContentItemTags.Select(ct => ct.Tag).ToList();

                <RecipeIndexCard Slug="@item.Slug"
                                 HeroUrl="@(hero?.StorageKey ?? "")"
                                 AltText="@(hero?.AltText ?? item.Title)"
                                 Tags="@tags"
                                 Title="@item.Title"
                                 Author="@item.Author"
                                 PublishedAt="@item.PublishedAt" />
            }
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "tag")] public string? TagSlug { get; set; }

    private List<ContentItem>? recipes;
    private string searchTerm = "";

    private IEnumerable<ContentItem> filteredRecipes =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? recipes ?? []
            : (recipes ?? []).Where(r =>
            r.Title.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
            r.ContentItemTags.Any(ct => ct.Tag.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnParametersSetAsync()
    {
        recipes = await RecipeService.GetPublishedAsync(TagSlug);
    }

    private void HandleSearchChanged(string term)
    {
        searchTerm = term;
    }
}
